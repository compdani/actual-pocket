{
  "name": "actual",
  "version": "0.0.1",
  "private": true,
  "description": "Actual Pocket, a personal fork of Actual Budget by Danilo Urrutia",
  "homepage": "https://github.com/compdani/actual-pocket/",
  "bugs": {
    "url": "https://github.com/compdani/actual-pocket/issues/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:compdani/actual-pocket.git"
  },
  "scripts": {
    "start": "pnpm run start:browser",
    "start:server": "pnpm --filter @actual-app/sync-server run start",
    "start:server-monitor": "pnpm --filter @actual-app/sync-server run start-monitor",
    "start:server-dev": "NODE_ENV=development BROWSER_OPEN=localhost:5006 npm-run-all --parallel 'start:server-monitor' 'start'",
    "start:desktop": "node ./bin/package-wails.mjs --run",
    "start:docs": "pnpm --filter docs run start",
    "start:browser": "npm-run-all --parallel 'start:browser-*' 'start:service-plugins'",
    "start:service-plugins": "pnpm --filter plugins-service run watch",
    "start:browser-frontend": "pnpm --filter @actual-app/web run start:browser",
    "start:storybook": "pnpm --filter @actual-app/components run start:storybook",
    "build": "lage build",
    "start:ios": "pnpm run build:browser --mobile && pnpm --filter mobile-client run start:ios",
    "start:android": "pnpm run build:browser --mobile && pnpm --filter mobile-client run start:android",
    "build:server": "pnpm run build:browser && pnpm --filter @actual-app/sync-server run build",
    "build:browser": "./bin/package-browser",
    "build:desktop": "node ./bin/package-wails.mjs",
    "build:plugins-service": "pnpm --filter plugins-service run build",
    "build:api": "pnpm run build --scope=@actual-app/api",
    "build:mobile": "pnpm run build --scope=mobile-client",
    "release:android": "pnpm run build:browser --mobile && pnpm --filter mobile-client run release:android",
    "build:cli": "pnpm run build --scope=@actual-app/cli",
    "build:docs": "pnpm --filter docs run build",
    "build:storybook": "pnpm --filter @actual-app/components run build:storybook",
    "deploy:docs": "pnpm --filter docs run deploy",
    "generate:i18n": "pnpm --filter @actual-app/web run generate:i18n",
    "generate:release-notes": "node ./bin/release-note-generator.mts",
    "generate:news-feed": "tsx packages/ci-actions/bin/generate-news-feed.ts",
    "test": "lage test --continue",
    "test:debug": "lage test --no-cache --continue",
    "e2e": "pnpm --filter @actual-app/web run e2e",
    "playwright": "pnpm --filter @actual-app/web run playwright",
    "vrt": "pnpm --filter @actual-app/web run vrt",
    "vrt:docker": "./bin/run-vrt",
    "rebuild-node": "pnpm --filter @actual-app/core run rebuild",
    "lint": "oxfmt --check . && oxlint --type-aware --quiet",
    "lint:fix": "oxfmt . && oxlint --fix --type-aware --quiet",
    "knip": "knip",
    "install:server": "pnpm install --prod --filter @actual-app/sync-server...",
    "constraints": "node ./bin/check-dependency-versions.mjs",
    "typecheck": "tsgo -p tsconfig.root.json --noEmit && lage typecheck",
    "check:tsconfig-references": "workspaces-to-typescript-project-references --check",
    "sync:tsconfig-references": "workspaces-to-typescript-project-references",
    "prepare": "husky"
  },
  "devDependencies": {
    "@actual-app/api": "workspace:*",
    "@monorepo-utils/workspaces-to-typescript-project-references": "^2.11.0",
    "@octokit/rest": "^22.0.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.0",
    "@types/node": "^22.20.5",
    "@types/prompts": "^2.4.9",
    "@typescript/native-preview": "beta",
    "eslint": "^10.12.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-typescript-paths": "^0.0.33",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lage": "^2.17.0",
    "minimatch": "^10.2.6",
    "nano-staged": "^1.0.2",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "p-limit": "^7.3.3",
    "playwright-core": "1.61.1",
    "prompts": "^2.4.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "optionalDependencies": {
    "glob-hasher-linux-arm64-gnu": "1.4.2"
  },
  "browserslist": [
    "defaults"
  ],
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.21.0"
  },
  "packageManager": "pnpm@12.21.0"
}
